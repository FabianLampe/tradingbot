# secrets
.env
.env.local

# data (never commit downloaded market data)
# Leading slash: only the top-level cache — `data/` alone would also
# swallow the src/data/ ingestion package.
/data/
*.parquet
*.db
*.sqlite

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# notebooks: keep outputs out of git
# (run `jupyter nbconvert --clear-output --inplace notebook.ipynb` before commit)
