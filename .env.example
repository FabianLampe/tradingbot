# Copy this file to ".env" and fill in your keys.
# .env is gitignored — never commit real keys.

# Finnhub: https://finnhub.io/  (free tier: 60 calls/min)
FINNHUB_API_KEY=

# FRED: https://fred.stlouisfed.org/docs/api/api_key.html  (free, instant)
FRED_API_KEY=

# Optional: Alpha Vantage (alternative news source, 25 calls/day free)
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ---- Reddit (free) ----
# https://www.reddit.com/prefs/apps  -> create "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-bot/0.1

# ---- LLM backend for post-mortem analysis (Phase 3b) ----
# Pick one: "claude" (Anthropic API, paid) or "local" (HuggingFace on your GPU)
LLM_BACKEND=claude
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# ---- Telegram bot (Phase 5) ----
# Talk to @BotFather on Telegram -> /newbot -> get token
# To get your chat id: send any message to the bot, then GET
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where to store downloaded data (relative to project root by default)
DATA_DIR=data
